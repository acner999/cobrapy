generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================================================
// MERCHANTS - comercios que cobran a través de CobraPy
// =====================================================
model Merchant {
  id            String   @id @default(cuid())
  businessName  String   @map("business_name")
  ruc           String   @unique
  email         String   @unique
  phone         String?
  kycStatus     KycStatus @default(PENDING) @map("kyc_status")
  plan          Plan     @default(FREE)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  apiKeys       ApiKey[]
  charges       Charge[]
  webhooks      WebhookEndpoint[]
  bankAccounts  BankAccount[]
  paymentLinks  PaymentLink[]
  memberships   Membership[]

  @@map("merchants")
}

// =====================================================
// USERS - personas humanas que se loguean al dashboard
// =====================================================
model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String   @map("password_hash")
  name          String
  emailVerified DateTime? @map("email_verified")
  lastLoginAt   DateTime? @map("last_login_at")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  memberships   Membership[]

  @@map("users")
}

// =====================================================
// MEMBERSHIPS - relación many-to-many entre User y Merchant con rol
// =====================================================
model Membership {
  id          String         @id @default(cuid())
  userId      String         @map("user_id")
  merchantId  String         @map("merchant_id")
  role        MembershipRole
  invitedBy   String?        @map("invited_by")
  acceptedAt  DateTime?      @map("accepted_at")
  createdAt   DateTime       @default(now()) @map("created_at")

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchant    Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([userId, merchantId])
  @@index([merchantId])
  @@index([userId])
  @@map("memberships")
}

enum MembershipRole {
  OWNER
  ADMIN
  OPERATOR
  READONLY
}

// =====================================================
// WHATSAPP - vínculo entre número de teléfono y comercio
// =====================================================
model WhatsAppAccount {
  id          String    @id @default(cuid())
  phone       String    @unique
  merchantId  String    @map("merchant_id")
  userId      String?   @map("user_id")
  active      Boolean   @default(true)
  verifiedAt  DateTime? @map("verified_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([merchantId])
  @@map("whatsapp_accounts")
}

model WhatsAppMessage {
  id          String      @id @default(cuid())
  direction   WaDirection
  fromPhone   String      @map("from_phone")
  toPhone     String?     @map("to_phone")
  body        String      @db.Text
  intent      String?
  chargeId    String?     @map("charge_id")
  merchantId  String?     @map("merchant_id")
  createdAt   DateTime    @default(now()) @map("created_at")

  @@index([fromPhone, createdAt])
  @@index([merchantId])
  @@map("whatsapp_messages")
}

enum WaDirection {
  INBOUND
  OUTBOUND
}

enum KycStatus {
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
}

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

// =====================================================
// API KEYS - autenticación de comercios para llamar la API
// =====================================================
model ApiKey {
  id          String   @id @default(cuid())
  merchantId  String   @map("merchant_id")
  name        String
  keyPrefix   String   @map("key_prefix") // primeros 8 chars visibles, ej: "ck_live_"
  keyHash     String   @map("key_hash")   // bcrypt del resto
  environment Environment @default(TEST)
  lastUsedAt  DateTime? @map("last_used_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime @default(now()) @map("created_at")

  merchant    Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([keyPrefix])
  @@index([merchantId])
  @@map("api_keys")
}

enum Environment {
  TEST
  LIVE
}

// =====================================================
// BANKS - bancos disponibles en Paraguay
// =====================================================
model Bank {
  code        String   @id // ej: "BMP", "BCI"
  name        String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")

  bankAccounts BankAccount[]

  @@map("banks")
}

// =====================================================
// BANK ACCOUNTS - cuentas destino donde se acreditan los pagos
// =====================================================
model BankAccount {
  id              String   @id @default(cuid())
  merchantId      String   @map("merchant_id")
  bankCode        String   @map("bank_code")
  accountNumber   String   @map("account_number")
  accountAlias    String?  @map("account_alias")
  isDefault       Boolean  @default(false) @map("is_default")
  documentType    String?  @map("document_type")    // RUC, CEDULA, PASAPORTE
  document        String?  @map("document")         // número de documento
  nameOrBusinessName String? @map("name_or_business_name")
  createdAt       DateTime @default(now()) @map("created_at")

  merchant        Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  bank            Bank     @relation(fields: [bankCode], references: [code])

  @@index([merchantId])
  @@map("bank_accounts")
}

// =====================================================
 // PAYMENT LINKS - links compartibles para cobrar por WhatsApp, redes, etc.
 // =====================================================
 model PaymentLink {
   id            String   @id @default(cuid())
   merchantId    String   @map("merchant_id")
   slug          String   @unique // la parte visible del URL, ej: "pago/juan-estancia"
   title         String?  // título opcional para identificar el link
   amountGs      BigInt?  @map("amount_gs") // null = el cliente elige monto
   description   String?
   expiresAt     DateTime? @map("expires_at")
   maxUses       Int?     @map("max_uses") // null = ilimitado
   usesCount     Int      @default(0) @map("uses_count")
   active        Boolean  @default(true)
   createdAt     DateTime @default(now()) @map("created_at")

   merchant      Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

   @@index([merchantId])
   @@index([slug])
   @@map("payment_links")
 }

 // =====================================================
 // CHARGES - intentos de cobro (request del comercio)
 // =====================================================
model Charge {
  id              String   @id @default(cuid())
  merchantId      String   @map("merchant_id")
  amountGs        BigInt   @map("amount_gs")        // monto en guaraníes (sin decimales en PYG)
  description     String?
  status          ChargeStatus @default(PENDING)
  paymentType     PaymentType  @map("payment_type")
  qrPayload       String?  @map("qr_payload") @db.Text
  qrImageUrl      String?  @map("qr_image_url")
  externalId      String?  @map("external_id")     // ID del comercio para idempotencia
  metadata        Json?
  expiresAt       DateTime? @map("expires_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  merchant        Merchant @relation(fields: [merchantId], references: [id])
  transactions    Transaction[]

  @@unique([merchantId, externalId])
  @@index([merchantId, status])
  @@index([createdAt])
  @@map("charges")
}

enum ChargeStatus {
  PENDING
  PROCESSING
  PAID
  EXPIRED
  CANCELED
  FAILED
}

enum PaymentType {
  QR_DYNAMIC
  QR_STATIC
  PAYMENT_LINK
  API_DIRECT
}

// =====================================================
// TRANSACTIONS - eventos reales de pago confirmados por SIP
// (append-only, nunca UPDATE — el estado se modela por nuevas filas)
// =====================================================
model Transaction {
  id              String   @id @default(cuid())
  chargeId        String   @map("charge_id")
  sipTransactionId String? @unique @map("sip_transaction_id")
  amountGs        BigInt   @map("amount_gs")
  feeGs           BigInt   @default(0) @map("fee_gs")
  netAmountGs     BigInt   @map("net_amount_gs")
  payerName       String?  @map("payer_name")
  payerDocument   String?  @map("payer_document")
  payerBankCode   String?  @map("payer_bank_code")
  status          TransactionStatus
  rawSipResponse  Json?    @map("raw_sip_response")
  occurredAt      DateTime @default(now()) @map("occurred_at")

  charge          Charge   @relation(fields: [chargeId], references: [id])
  ledgerEntries   LedgerEntry[]

  @@index([chargeId])
  @@index([occurredAt])
  @@map("transactions")
}

enum TransactionStatus {
  COMPLETED
  REVERSED
  REFUNDED
  FAILED
}

// =====================================================
// LEDGER - contabilidad de doble entrada (append-only)
// Por cada transacción se crean N filas que deben sumar 0
// =====================================================
model LedgerEntry {
  id              String   @id @default(cuid())
  transactionId   String   @map("transaction_id")
  account         String   // ej: "merchant:xxx", "cobrapy:fees", "sip:settlement"
  debitGs         BigInt   @default(0) @map("debit_gs")
  creditGs        BigInt   @default(0) @map("credit_gs")
  description     String?
  createdAt       DateTime @default(now()) @map("created_at")

  transaction     Transaction @relation(fields: [transactionId], references: [id])

  @@index([transactionId])
  @@index([account])
  @@map("ledger_entries")
}

// =====================================================
// WEBHOOKS - endpoints HTTP que el comercio registra
// =====================================================
model WebhookEndpoint {
  id          String   @id @default(cuid())
  merchantId  String   @map("merchant_id")
  url         String
  secret      String   // para firmar el payload con HMAC-SHA256
  events      String[] // ej: ["charge.paid", "charge.expired"]
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")

  merchant    Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  deliveries  WebhookDelivery[]

  @@index([merchantId])
  @@map("webhook_endpoints")
}

model WebhookDelivery {
  id              String   @id @default(cuid())
  endpointId      String   @map("endpoint_id")
  eventType       String   @map("event_type")
  payload         Json
  status          DeliveryStatus @default(PENDING)
  attempts        Int      @default(0)
  lastAttemptAt   DateTime? @map("last_attempt_at")
  responseStatus  Int?     @map("response_status")
  responseBody    String?  @map("response_body") @db.Text
  nextRetryAt     DateTime? @map("next_retry_at")
  createdAt       DateTime @default(now()) @map("created_at")

  endpoint        WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([status, nextRetryAt])
  @@index([endpointId])
  @@map("webhook_deliveries")
}

enum DeliveryStatus {
  PENDING
  DELIVERED
  FAILED
  ABANDONED
}

// =====================================================
// ADMINS - usuarios internos del equipo CobraPy
// =====================================================
model Admin {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String    @map("password_hash")
  name          String
  role          AdminRole @default(STAFF)
  active        Boolean   @default(true)
  lastLoginAt   DateTime? @map("last_login_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("admins")
}

enum AdminRole {
  SUPERADMIN
  STAFF
  READONLY
}

// =====================================================
// AUDIT LOG - todo cambio sensible queda registrado
// =====================================================
model AuditLog {
  id          String   @id @default(cuid())
  merchantId  String?  @map("merchant_id")
  actor       String   // "merchant:xxx", "system", "admin:yyy"
  action      String   // "charge.created", "apikey.revoked", etc.
  resource    String?
  metadata    Json?
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([merchantId, createdAt])
  @@index([action])
  @@map("audit_logs")
}
