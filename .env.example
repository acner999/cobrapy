NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://cobrapy:cobrapy@localhost:5432/cobrapy?schema=public

REDIS_HOST=localhost
REDIS_PORT=6379

JWT_SECRET=change-me-in-production-use-openssl-rand-base64-32
API_KEY_PEPPER=change-me-too
ADMIN_TOKEN=local-dev-admin-token-change-me

SIP_API_BASE_URL=https://sandbox.sip.bcp.gov.py
SIP_PARTICIPANT_ID=mock-participant-id
SIP_CLIENT_CERT_PATH=./certs/client.pem
SIP_CLIENT_KEY_PATH=./certs/client.key

WEBHOOK_SIGNING_SECRET=change-me-three

# WhatsApp / Twilio (opcionales — sin ellos el sender solo loggea)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

PUBLIC_BASE_URL=http://localhost:3001

# === Seed (solo aplica al correr `npm run db:seed`) ===
# En desarrollo se pueden dejar vacíos: el seed usa defaults visibles solo en dev.
# En producción es OBLIGATORIO completarlos; si NODE_ENV=production y faltan, el seed aborta.
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=
SEED_ADMIN_PASSWORD=
SEED_DEMO_EMAIL=
SEED_DEMO_NAME=
SEED_DEMO_PASSWORD=
SEED_DEMO_RUC=80000000-1
SEED_DEMO_PHONE=+595981000000
SEED_MANAGER_EMAIL=
SEED_MANAGER_NAME=
SEED_MANAGER_PASSWORD=
SEED_OPERATOR_EMAIL=
SEED_OPERATOR_NAME=
SEED_OPERATOR_PASSWORD=
SEED_ACCOUNTANT_EMAIL=
SEED_ACCOUNTANT_NAME=
SEED_ACCOUNTANT_PASSWORD=
