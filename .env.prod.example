# Copiar este archivo como .env.prod y completar los valores reales
# NUNCA subir .env.prod a git

# Base de datos
DATABASE_URL=postgresql://postgres:PASSWORD@HOST.railway.internal:5432/railway

# Redis
REDIS_URL=redis://default:PASSWORD@HOST.railway.internal:6379

# JWT y seguridad
JWT_SECRET=CAMBIAR_POR_STRING_ALEATORIO_LARGO_64_CHARS
ADMIN_TOKEN=CAMBIAR_POR_TOKEN_SEGURO

# Entorno
NODE_ENV=production

# Seed — usuario del DASHBOARD (entra por /auth/login)
SEED_DEMO_EMAIL=acner@elyon.com.py
SEED_DEMO_NAME=Acner Pinazo
SEED_DEMO_PASSWORD=cobrapy123

# Seed — usuarios de prueba del mismo comercio
SEED_MANAGER_EMAIL=gerente@elyon.com.py
SEED_MANAGER_NAME=Gerente Demo
SEED_MANAGER_PASSWORD=cobrapy123

SEED_OPERATOR_EMAIL=cajero@elyon.com.py
SEED_OPERATOR_NAME=Cajero Demo
SEED_OPERATOR_PASSWORD=cobrapy123

SEED_ACCOUNTANT_EMAIL=contador@elyon.com.py
SEED_ACCOUNTANT_NAME=Contador Demo
SEED_ACCOUNTANT_PASSWORD=cobrapy123

# Seed — admin del PORTAL ADMIN (entra por /admin-portal/auth/login)
