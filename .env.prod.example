# Copiar este archivo como .env.prod y completar los valores reales
# NUNCA subir .env.prod a git

# Base de datos (usada por docker-compose.prod.yml)
DB_USER=cobrapy
DB_PASSWORD=CAMBIAR_POR_PASSWORD_SEGURO
DB_NAME=cobrapy

# Prisma — apunta al servicio postgres interno de Docker
DATABASE_URL=postgresql://cobrapy:CAMBIAR_POR_PASSWORD_SEGURO@postgres:5432/cobrapy

# Redis — apunta al servicio redis interno de Docker
REDIS_URL=redis://redis:6379

# JWT
JWT_SECRET=CAMBIAR_POR_STRING_ALEATORIO_LARGO_64_CHARS

# Admin staff seed
ADMIN_TOKEN=CAMBIAR_POR_TOKEN_SEGURO
SEED_ADMIN_EMAIL=admin@tuempresa.com
SEED_ADMIN_PASSWORD=CAMBIAR_POR_PASSWORD_SEGURO
SEED_ADMIN_NAME=Admin CobraPy

# Merchant de prueba (seed)
SEED_MERCHANT_NAME=CobraPy Demo
SEED_MERCHANT_EMAIL=demo@tuempresa.com
SEED_MERCHANT_PASSWORD=CAMBIAR_POR_PASSWORD_SEGURO

# Twilio WhatsApp (opcional)
# TWILIO_ACCOUNT_SID=ACxxxx
# TWILIO_AUTH_TOKEN=xxxx
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
